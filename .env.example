# ─────────────────────────────────────────────────────────────────────────────
# How_To_Become_Warren_Buffett — 비밀값 목록 (이름만 · 값은 비워 둔다)
#
#   cp .env.example .env && chmod 600 .env     # 그다음 .env 에만 진짜 값을 넣는다
#
# 🔴 .env 는 .gitignore 에 있고, tests/test_leak_guard.py 와 pre-commit(gitleaks)가 추적·유출을 막는다.
# 🔴 이 파일(.env.example)은 저장소에 올라간다 → 여기에는 절대 진짜 값을 넣지 않는다.
# 🔴 값에 따옴표를 붙이지 않는다. 값 뒤에 주석을 붙이지 않는다.
# ─────────────────────────────────────────────────────────────────────────────

# 뉴스: RTPR (WebSocket 알림 + 기사 본문)
HBWB_RTPR_KEY=

# AI: OpenRouter 하나로 Jev(TypeSafe) 와 Claude Opus 5.5 를 부른다
#     OpenRouter 키 설정에서 월 사용 한도(credit limit)를 꼭 걸어 둔다
HBWB_OPENROUTER_KEY=

# 브로커: 토스증권 Open API (WTS > 설정 > Open API 에서 발급 · 허용 IP 에 이 맥의 공인 IP 등록)
#     계좌번호는 여기에 넣지 않는다 — 코드가 GET /api/v1/accounts 로 accountSeq 를 실행 중에만 받아 쓴다
HBWB_TOSS_CLIENT_ID=
HBWB_TOSS_CLIENT_SECRET=

# 알림: Discord 웹훅 (채널 다섯). 웹훅 주소도 비밀값이다 — 알면 누구나 그 채널에 글을 쓸 수 있다
HBWB_DISCORD_WEBHOOK_ENTRIES=
HBWB_DISCORD_WEBHOOK_EXITS=
HBWB_DISCORD_WEBHOOK_WARNINGS=
HBWB_DISCORD_WEBHOOK_CRITICAL=
HBWB_DISCORD_WEBHOOK_DAILY_SUMMARY=
